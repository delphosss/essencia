# Porta HTTP
PORT=3000
# URL pública (usada em links de e-mail, WhatsApp e webhooks)
BASE_URL=http://localhost:3000
NODE_ENV=development
# Segredo da sessão e dos links assinados (troque em produção)
SESSION_SECRET=troque-este-segredo
# Caminho do banco SQLite
DATABASE_PATH=./data/essencia.db
# Pasta de uploads (fotos, banners, produtos)
UPLOAD_DIR=./public/uploads

# Admin criado no primeiro start (seed)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=admin123
# Perfil de atendimento da dona (Dama da Noite): recebe 100%, sem repasse
OWNER_EMAIL=damadanoite@exemplo.com
OWNER_PASSWORD=tarot123

# Pagamentos -------------------------------------------------------------
# Sem MP_ACCESS_TOKEN o checkout usa o simulador (só fora de produção).
MP_ACCESS_TOKEN=
# Segredo de assinatura do webhook do Mercado Pago (opcional, recomendado)
MP_WEBHOOK_SECRET=
# PayPal Payments Standard: e-mail da conta recebedora
PAYPAL_BUSINESS_EMAIL=
PAYPAL_SANDBOX=true
# Taxa de câmbio BRL->moeda do PayPal (o PayPal Standard cobra em BRL por padrão)
PAYPAL_CURRENCY=BRL

# Login com Google (Google Identity Services)
GOOGLE_CLIENT_ID=

# E-mail transacional (SMTP). Sem SMTP_HOST os e-mails vão para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Arcano <no-reply@exemplo.com>"

# WhatsApp (API HTTP estilo Z-API). Sem WHATSAPP_API_URL as mensagens vão para o log.
# A mensagem é enviada com POST JSON {phone, message} para esta URL.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
