<%- include('../partials/admin-top') %>
<form class="toolbar" method="get"><input class="input" name="busca" value="<%= search %>" placeholder="Nome, e-mail ou telefone"><button class="btn btn-outline btn-sm">Buscar</button></form>
<div class="table-wrap"><table class="table">
  <thead><tr><th>ID</th><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Saldo</th><th>Total gasto</th><th>Consultas</th><th>Cadastro</th><th>Status</th></tr></thead>
  <tbody>
    <% rows.forEach((u) => { %>
      <tr><td><%= u.id %></td><td><a href="/admin/clientes/<%= u.id %>"><%= u.name %></a></td><td class="small"><%= u.email %></td><td class="small"><%= u.area_code ? `(${u.area_code}) ` : '' %><%= u.phone %></td>
      <td><%= money(u.balance_cents) %></td><td><%= money(u.spent) %></td><td><%= u.consults %></td><td><%= fmtDate(u.created_at) %></td><td><%= u.blocked ? 'Bloqueado' : 'Ativo' %></td></tr>
    <% }) %>
  </tbody>
</table></div>
<%- include('../partials/admin-bottom') %>
