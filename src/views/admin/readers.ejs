<%- include('../partials/admin-top') %>
<div class="toolbar between"><p class="muted">Tarólogos cadastrados. Candidatos chegam por <a href="/admin/candidaturas">Candidaturas</a>.</p><a href="/admin/tarologos/novo" class="btn btn-gold btn-sm">Novo tarólogo</a></div>
<div class="table-wrap"><table class="table">
  <thead><tr><th></th><th>Nome</th><th>E-mail</th><th>Status</th><th>Chat</th><th>Vídeo</th><th>Pergunta</th><th>Repasse</th><th>Saldo a pagar</th><th>Depoim.</th><th>Destaque</th><th>Ativo</th><th></th></tr></thead>
  <tbody>
    <% readers.forEach((r) => { %>
      <tr>
        <td><%- include('../partials/avatar', { photo: r.photo, name: r.display_name, size: 'avatar-xs' }) %></td>
        <td><a href="/admin/tarologos/<%= r.id %>"><%= r.display_name %></a></td><td class="small"><%= r.email %></td>
        <td><%- include('../partials/status-label', { s: r.status }) %></td>
        <td><%= r.chat_enabled ? money(r.price_chat_cents) : '—' %></td><td><%= r.video_enabled ? money(r.price_video_cents) : '—' %></td><td><%= r.questions_enabled ? money(r.price_question_cents) : '—' %></td>
        <td><%= r.commission_percent %>%</td><td><%= money(r.earnings.availableCents) %></td><td><%= r.review_count %></td>
        <td><%= r.featured ? '★' : '' %></td><td><%= r.active ? 'Sim' : 'Não' %></td>
        <td class="nowrap">
          <form method="post" action="/admin/tarologos/<%= r.id %>/status" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (r.status === 'offline') { %><input type="hidden" name="status" value="online"><button class="btn btn-outline btn-sm">Pôr online</button>
            <% } else if (r.status === 'online') { %><input type="hidden" name="status" value="offline"><button class="btn btn-outline btn-sm">Pôr offline</button><% } %>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table></div>
<%- include('../partials/admin-bottom') %>
