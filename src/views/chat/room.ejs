<%- include('../partials/head') %>
<body class="room-page">
<div class="room" data-room="<%= c.code %>" data-role="<%= role %>" data-status="<%= c.status %>" data-type="<%= c.type %>" data-price="<%= c.price_per_min_cents %>">
  <header class="room-head">
    <a href="<%= role === 'reader' ? '/atendente' : role === 'admin' ? '/admin/consultas' : '/minha-conta' %>" class="logo logo-sm"><img src="/public/img/icon.svg" alt="" width="28" height="28"></a>
    <div class="room-who">
      <% if (role === 'reader') { %>
        <strong><%= client.name %></strong>
        <span class="muted small"><%= client.birth_date ? `Nascimento: ${fmtDate(client.birth_date + 'T12:00:00Z')}` : '' %></span>
      <% } else { %>
        <%- include('../partials/avatar', { photo: r.photo, name: r.display_name, size: 'avatar-sm' }) %>
        <strong><%= r.display_name %></strong>
      <% } %>
    </div>
    <div class="room-meter">
      <div><span class="muted small">Tempo</span><strong data-elapsed>00:00</strong></div>
      <div><span class="muted small"><%= role === 'reader' ? 'Tempo do cliente' : 'Tempo restante' %></span><strong data-remaining>--:--</strong></div>
      <% if (role === 'client') { %><div><span class="muted small">Saldo</span><strong data-room-balance><%= snapshot ? money(snapshot.balanceCents) : money(user.balance_cents) %></strong></div><% } %>
      <div><span class="muted small">Valor</span><strong><%= money(c.price_per_min_cents) %>/min</strong></div>
    </div>
    <div class="room-actions">
      <% if (role === 'reader') { %>
        <button type="button" class="btn btn-outline btn-sm" data-pause>Pausar</button>
        <button type="button" class="btn btn-outline btn-sm" data-resume hidden>Retomar</button>
      <% } %>
      <% if (role === 'client') { %><a href="/comprar-creditos" target="_blank" class="btn btn-outline btn-sm">Recarregar</a><% } %>
      <button type="button" class="btn btn-danger btn-sm" data-end <%= c.status === 'active' ? '' : 'hidden' %>>Encerrar</button>
    </div>
  </header>
  <div class="room-banner" data-room-banner hidden></div>
  <div class="room-body <%= c.type === 'video' ? 'with-video' : '' %>">
    <% if (c.type === 'video' && c.video_room) { %>
      <div class="video-wrap" data-video data-domain="<%= jitsiDomain %>" data-room-name="<%= c.video_room %>" data-display-name="<%= role === 'reader' ? r.display_name : user.name %>">
        <p class="muted center">O vídeo abre quando a consulta estiver ativa.</p>
      </div>
    <% } %>
    <div class="chat">
      <div class="chat-log" data-chat-log>
        <% messages.forEach((m) => { %>
          <div class="msg msg-<%= m.sender_role %> <%= m.sender_role === role ? 'mine' : '' %>"><div class="msg-body"><%= m.body %></div><time><%= fmtDateTime(m.created_at).slice(-5) %></time></div>
        <% }) %>
      </div>
      <div class="typing muted small" data-typing hidden>digitando…</div>
      <% if (role !== 'admin') { %>
        <form class="chat-form" data-chat-form <%= c.status === 'active' ? '' : 'hidden' %>>
          <textarea class="input" rows="1" maxlength="2000" placeholder="Escreva sua mensagem…" data-chat-input></textarea>
          <button class="btn btn-gold">Enviar</button>
        </form>
      <% } %>
      <div class="room-ended card card-body center" data-ended <%= c.status === 'active' ? 'hidden' : '' %>>
        <h3>Consulta encerrada</h3>
        <p data-ended-text><%= c.status === 'ended' ? `${c.minutes_charged} min · ${money(c.charged_cents)}` : '' %></p>
        <div class="toolbar center">
          <% if (role === 'client') { %>
            <a class="btn btn-gold" data-review-link href="/minha-conta/avaliar/<%= c.code %>" <%= canReview ? '' : 'hidden' %>>Avaliar atendimento</a>
            <a class="btn btn-outline" href="/tarologos">Voltar aos tarólogos</a>
          <% } else if (role === 'reader') { %>
            <a class="btn btn-gold" href="/atendente">Voltar ao painel</a>
          <% } else { %>
            <a class="btn btn-outline" href="/admin/consultas/<%= c.code %>">Detalhes</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toasts" data-toasts aria-live="polite"></div>
<script src="/socket.io/socket.io.js"></script>
<script src="/public/js/app.js"></script>
<% if (c.type === 'video') { %><script src="https://<%= jitsiDomain %>/external_api.js"></script><% } %>
<script src="/public/js/room.js"></script>
</body>
</html>
