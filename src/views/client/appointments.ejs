<%- include('../partials/client-top') %>
<h1 class="page-title left">Consultas agendadas</h1>
<p class="muted small">No horário marcado, abra o perfil do tarólogo e clique em "Consultar agora". Cancelamentos pelo site com até <%= cancelHours %>h de antecedência.</p>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Data e hora</th><th>Tarólogo</th><th>Status</th><th>Observações</th><th></th></tr></thead>
  <tbody>
    <% if (!appointments.length) { %><tr><td colspan="5" class="muted">Nenhum agendamento.</td></tr><% } %>
    <% appointments.forEach((a) => { %>
      <tr>
        <td><%= fmtDateTime(a.scheduled_at) %></td>
        <td><a href="/tarologo/<%= a.reader_slug %>"><%= a.reader_name %></a></td>
        <td><%- include('../partials/status-label', { s: a.status }) %><% if (a.cancel_reason) { %><br><span class="muted small"><%= a.cancel_reason %></span><% } %></td>
        <td><%= a.notes %></td>
        <td><% if (['requested', 'confirmed'].includes(a.status)) { %>
          <form method="post" action="/minha-conta/agendadas/<%= a.id %>/cancelar" class="inline-form" data-confirm="Cancelar este agendamento?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-sm">Cancelar</button></form>
        <% } %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>
<%- include('../partials/client-bottom') %>
