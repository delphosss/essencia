<%- include('../partials/client-top') %>
<h1 class="page-title left">Pedidos da loja</h1>
<% if (!orders.length) { %><p class="muted">Nenhum pedido. <a href="/loja">Conheça a loja</a>.</p><% } %>
<% orders.forEach((o) => { %>
  <div class="card card-body">
    <div class="toolbar between"><strong>Pedido #<%= o.id %></strong><span><%= fmtDateTime(o.created_at) %></span><%- include('../partials/status-label', { s: o.status }) %></div>
    <ul><% o.items.forEach((i) => { %><li><%= i.quantity %>× <%= i.name %> — <%= money(i.price_cents * i.quantity) %></li><% }) %></ul>
    <p>Total: <strong><%= money(o.total_cents) %></strong></p>
    <% if (o.status === 'pending') { %><a class="btn btn-gold btn-sm" href="/pagamento/<%= o.id %>">Pagar agora</a><% } %>
  </div>
<% }) %>
<%- include('../partials/client-bottom') %>
