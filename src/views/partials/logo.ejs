<% const _cls = locals.cls || ''; %>
<a href="<%= locals.href || '/' %>" class="logo <%= _cls %>" aria-label="<%= site.site_name %>">
  <% if (site.site_logo) { %>
    <img src="<%= site.site_logo %>" alt="<%= site.site_name %>" class="logo-img" width="252" height="78" <%= locals.lazy ? 'loading=lazy' : 'fetchpriority=high' %>>
  <% } else { %>
    <img src="<%= site.site_favicon || '/public/img/icon.svg' %>" alt="" width="40" height="40"><span><%= site.site_name %></span>
  <% } %>
</a>
