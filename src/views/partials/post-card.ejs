<article class="card post-card">
  <a href="/blog/<%= p.slug %>" class="post-cover" aria-label="<%= p.title %>">
    <% if (p.cover) { %><img src="<%= p.cover %>" srcset="<%= srcset(p.cover, 1400) %>" sizes="(max-width: 640px) 100vw, 380px" alt="" loading="lazy" decoding="async"><% } %>
  </a>
  <div class="card-body">
    <% if (p.category_name) { %><a class="chip chip-sm" href="/blog/categoria/<%= p.category_slug %>"><%= p.category_name %></a><% } %>
    <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
    <p class="muted"><%= truncate(p.excerpt, 140) %></p>
    <span class="muted small"><%= fmtDate(p.published_at) %></span>
  </div>
</article>
