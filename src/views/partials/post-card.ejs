<article class="card post-card">
  <a href="/blog/<%= p.slug %>" class="post-cover" <% if (p.cover) { %>style="background-image:url('<%= p.cover %>')"<% } %>></a>
  <div class="card-body">
    <% if (p.category_name) { %><a class="chip chip-sm" href="/blog/categoria/<%= p.category_slug %>"><%= p.category_name %></a><% } %>
    <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
    <p class="muted"><%= truncate(p.excerpt, 140) %></p>
    <span class="muted small"><%= fmtDate(p.published_at) %></span>
  </div>
</article>
