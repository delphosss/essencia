<%- include('../partials/header') %>
<section class="section">
  <div class="container narrow">
    <h1 class="page-title">Trabalhe conosco</h1>
    <p class="center muted">Você é tarólogo(a) ou oraculista? Envie seus dados. Nossa equipe analisa cada candidatura e entra em contato.</p>
    <form method="post" action="/trabalhe-conosco" class="form card card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <h3>Dados pessoais</h3>
      <div class="row-2">
        <label class="field"><span>Nome completo *</span><input class="input" name="name" required></label>
        <label class="field"><span>E-mail *</span><input class="input" type="email" name="email" required></label>
      </div>
      <div class="row-2">
        <label class="field"><span>Data de nascimento *</span><input class="input" type="date" name="birth_date" required></label>
        <label class="field"><span>Celular / WhatsApp *</span><input class="input" name="phone" required></label>
      </div>
      <label class="field"><span>País, cidade e endereço *</span><input class="input" name="location" required></label>
      <div class="row-3">
        <label class="field"><span>Facebook</span><input class="input" name="facebook"></label>
        <label class="field"><span>Instagram</span><input class="input" name="instagram"></label>
        <label class="field"><span>YouTube</span><input class="input" name="youtube"></label>
      </div>
      <h3>Dados profissionais</h3>
      <div class="row-2">
        <label class="field"><span>Nome profissional *</span><input class="input" name="professional_name" required></label>
        <label class="field"><span>Tempo de experiência *</span><input class="input" name="experience" required placeholder="Ex.: 5 anos"></label>
      </div>
      <label class="field"><span>Horários em que pode atender *</span><input class="input" name="schedule" required></label>
      <label class="field"><span>Oráculos que utiliza *</span><input class="input" name="oracles" required></label>
      <label class="field"><span>Conte sobre seu estilo de atendimento *</span><textarea class="input" name="profile" rows="5" required></textarea></label>
      <label class="check"><input type="checkbox" name="terms" value="1" required> Li e aceito os <a href="/termos-de-uso" target="_blank">termos de uso</a></label>
      <button class="btn btn-gold">Enviar candidatura</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
