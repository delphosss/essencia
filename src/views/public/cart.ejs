<%- include('../partials/header') %>
<section class="section">
  <div class="container narrow">
    <h1 class="page-title">Carrinho</h1>
    <% if (!items.length) { %>
      <p class="muted center">Seu carrinho está vazio.</p><p class="center"><a class="btn btn-gold" href="/loja">Ir para a loja</a></p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Produto</th><th>Qtd.</th><th>Preço</th><th>Total</th></tr></thead>
        <tbody>
          <% items.forEach((i) => { %>
            <tr>
              <td><a href="/loja/produto/<%= i.product.slug %>"><%= i.product.name %></a></td>
              <td>
                <form method="post" action="/carrinho" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= i.productId %>"><input type="hidden" name="mode" value="set">
                  <input class="input input-sm" type="number" name="quantity" value="<%= i.quantity %>" min="0" max="99" onchange="this.form.submit()">
                </form>
              </td>
              <td><%= money(i.product.price_cents) %></td>
              <td><%= money(i.lineCents) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr><th colspan="3">Total</th><th><%= money(totalCents) %></th></tr></tfoot>
      </table>
      <form method="post" action="/carrinho/finalizar" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% items.filter((i) => i.product.requires_details).forEach((i) => { %>
          <fieldset class="fieldset">
            <legend>Dados para: <%= i.product.name %></legend>
            <label class="field"><span>Nome completo da(s) pessoa(s) envolvida(s) *</span><input class="input" name="people_<%= i.productId %>" required maxlength="500"></label>
            <label class="field"><span>Data(s) de nascimento</span><input class="input" name="birthdates_<%= i.productId %>" maxlength="200" placeholder="Ex.: 10/05/1990 e 22/11/1988"></label>
            <label class="field"><span>Seu pedido / intenção *</span><textarea class="input" name="intention_<%= i.productId %>" rows="3" required maxlength="1000"></textarea></label>
          </fieldset>
        <% }) %>
        <label class="field"><span>Observações gerais (opcional)</span><textarea class="input" name="notes" rows="2"></textarea></label>
        <p class="muted small">Seus dados são confidenciais e usados apenas para a realização do trabalho.</p>
        <button class="btn btn-gold btn-block"><%= user ? 'Finalizar compra' : 'Entrar para finalizar' %></button>
      </form>
      <p class="muted small">Para remover um item, altere a quantidade para 0.</p>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
