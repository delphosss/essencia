<%- include('../partials/reader-top') %>
<form method="post" action="/atendente/perfil" enctype="multipart/form-data" class="form card card-body">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row-2">
    <div>
      <div class="field"><span>Foto</span><%- include('../partials/avatar', { photo: reader.photo, name: reader.display_name, size: 'avatar-lg' }) %><input class="input" type="file" name="photo" accept="image/*"></div>
      <label class="field"><span>Oráculos que utiliza</span><input class="input" name="oracles" value="<%= reader.oracles || '' %>"></label>
      <fieldset class="fieldset"><legend>Especialidades</legend>
        <div class="check-grid"><% categories.forEach((c) => { %><label class="check"><input type="checkbox" name="categories" value="<%= c.id %>" <%= selected.includes(c.id) ? 'checked' : '' %>> <%= c.name %></label><% }) %></div>
      </fieldset>
    </div>
    <div>
      <label class="field"><span>Apresentação</span><textarea class="input" name="bio" rows="10"><%= reader.bio || '' %></textarea></label>
      <label class="field"><span>WhatsApp para alertas de chamada (com DDD)</span><input class="input" name="whatsapp" value="<%= reader.whatsapp || '' %>"></label>
      <label class="field"><span>Chave Pix para saques</span><input class="input" name="pix_key" value="<%= reader.pix_key || '' %>"></label>
      <label class="check"><input type="checkbox" name="chat_enabled" value="1" <%= reader.chat_enabled ? 'checked' : '' %>> Atender por chat</label>
      <label class="check"><input type="checkbox" name="questions_enabled" value="1" <%= reader.questions_enabled ? 'checked' : '' %>> Receber perguntas pagas</label>
    </div>
  </div>
  <fieldset class="fieldset"><legend>Preços</legend>
    <% if (canSetPrices) { %>
      <div class="row-3">
        <label class="field"><span>Chat (R$/min)</span><input class="input" name="price_chat" value="<%= centsToInput(reader.price_chat_cents) %>"></label>
        <label class="field"><span>Vídeo (R$/min)</span><input class="input" name="price_video" value="<%= centsToInput(reader.price_video_cents) %>"></label>
        <label class="field"><span>Pergunta (R$)</span><input class="input" name="price_question" value="<%= centsToInput(reader.price_question_cents) %>"></label>
      </div>
      <label class="check"><input type="checkbox" name="video_enabled" value="1" <%= reader.video_enabled ? 'checked' : '' %>> Atender por vídeo</label>
    <% } else { %>
      <p class="muted">Chat <%= money(reader.price_chat_cents) %>/min · Vídeo <%= reader.video_enabled ? `${money(reader.price_video_cents)}/min` : 'desativado' %> · Pergunta <%= money(reader.price_question_cents) %>. Os preços são definidos pela administração.</p>
    <% } %>
  </fieldset>
  <button class="btn btn-gold">Salvar perfil</button>
</form>
<%- include('../partials/reader-bottom') %>
